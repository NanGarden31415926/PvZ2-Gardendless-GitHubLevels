            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Those annoying imps always pisses me off!",
                            "zh": "这些小鬼可真够烦人的！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SPECIAL1",
                        "Lines": {
                            "en": "They'd ruin everything you appreciate! Especially when there's a whole horde of them!",
                            "zh": "他们会吃掉你珍视的一切！尤其是当他们数量多起来后！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "That is indeed a common concern, User Dave......",
                            "zh": "这样的顾虑的确很常见，用户戴夫……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I would personally suggest *PLANTING GUACODILES* in those Aqua Vines to eliminate some of the imps!",
                            "zh": "我建议「在水藤里种植鳄梨」以消灭这些恼人的小鬼僵尸"
                        }
                    }
                ]
            }
        },
