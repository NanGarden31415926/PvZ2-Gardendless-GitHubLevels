    {
      "objclass": "NarrativeProperties",
      "aliases": [
        "AQUAVINE_4"
      ],
      "objdata": {
        "Flow": [
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Well,a Watery Grave of sorts.",
              "zh": "好吧，看来是某种意义上的水上坟墓。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Penny.Some of my old pals want to assist in this battle,but several can't be planted on Lily Pads due to their deep roots.",
              "zh": "潘妮，我的一些老伙计想协助这场战斗，但他们中的一些深根扎入地底不能被种植在莲叶上。"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Don't worry.This is no longer a problem,User Dave.",
              "zh": "别为此担心，用户戴夫。"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "We know that plants with deep roots like Resistant Radishes cannot be planted on Lily Pads.",
              "zh": "我们知道，像白萝卜这样的深根植物不能被种植在莲叶上。"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "But Aqua Vines enable them join in aquatic battle.",
              "zh": "但水生藤蔓可以使他们也能参与水上作战。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en": "The same rule applies to our comrade!",
              "zh": "对我们的老战友同样适用的规则！"
            }
          }
        ]
      }
    },
