    {
      "aliases": [
        "NEW_EGYPT10_INTRO"
      ],
      "objclass": "NarrativeProperties",
      "objdata": {
        "#": "由 翼德大大 编写",
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "Look at those seedpacks!",
              "zh": "看那些种子包！"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "They're shiny just like gold from the Nile River!",
              "zh": "像尼罗河的金子一样金光闪闪！"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "These are BOOSTED seedpacks.",
              "zh": "这些种子包是爆发过的。"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "They will unleash their plant food effect immediately you plant them.",
              "zh": "它们将在种植后立即释放一次叶绿素效果。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "Let's wipe the floor with those zombies!",
              "zh": "把僵尸打个底朝天！"
            }
          }
        ]
      }
    },
    {
      "aliases": [
        "NEW_EGYPT10_OUTRO"
      ],
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "That feels CRAAAAAAAAAZY!",
              "zh": "感觉疯——狂极了！"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "I can't stop using them!",
              "zh": "简直停不下来！"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "We can gain BOOSTS, User Dave.",
              "zh": "用户戴夫，我们可以自己获取爆发。"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "You can get BOOSTS by shovelling mature plants in Zen Garden,",
              "zh": "爆发可以通过铲除禅境花园中成熟的植物获得，"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "or buy one with gems when choosing your seeds.",
              "zh": "或是在选择你的植物时花费钻石购买一份。"
            }
          }
        ]
      }
    },
