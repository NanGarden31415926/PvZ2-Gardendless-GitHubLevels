    {
      "aliases": [
        "NEW_EGYPT9_OUTRO"
      ],
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "It seems the stalling tactic is working really well.",
              "zh": "看来拖延战术确实很有效。"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "You know,",
              "zh": "你知道吗，"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "there's a specific name for this stalling tactic.",
              "zh": "这种拖延当前波次的僵尸，有一种专门的叫法。"
            }
          },
          
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "It's called \"Wave Stalling\".",
              "zh": "叫“拖过波”。"
            }
          }
        ]
      }
    },
