      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "I've deployed a powerful troop on your lawn.",
              "zh": ""
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Command them with Escape Root.",
              "zh": "你需要"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "By the way, this root is an employee at the logistics station in town.",
              "zh": "顺带一提，这个树根是镇子上那家物流站的员工。"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "I've also prepared a few extra troops for you.",
              "zh": "我准备了几支额外的队伍。"
            }
          },
          {
            "Character": "winnie",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "Choose one of them to support.",
              "zh": "你可以选择其中一支来支援草坪。"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Always make sure not to lose your commander.",
              "zh": "切记不要丢失指挥权。"
            }
          }
        ]
      }
    }
