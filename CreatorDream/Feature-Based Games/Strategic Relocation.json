					[
						"RTID(BeatTheLevel@CurrentLevel)"
					]
				],
				"ChallengesAlwaysAvailable": true
			}
		},
		{
			"aliases": [
			  "BeatTheLevel"
		  ],
			"objclass": "StarChallengeBeatTheLevelProps",
			"objdata": {
				"DescriptionsMultilanguage": [
					{
					  "en": "Tips:Using an Escape Root when a fishing hook grabs a plant can achieve cross-lane pulling.",
					  "zh": "提示：鱼钩钩住植物时使用逃脱树根可以实现跨行牵引。"
					}
				]
			}
	  },
    {
      "aliases":[
        "Backwards_Intro"
      ],
      "objclass":"NarrativeProperties",
      "objdata":{
        "Flow":[
          {
            "Character":"zombossicon",
            "Action":"NPC_ENTER"
          },
          {
            "Character":"zombossicon",
            "Action":"SAY",
            "Lines":{
              "en":"My teleportation technology is already completely perfected.",
              "zh":"我的传送科技已经登峰造极。"
            }
          },
          {
            "Character":"zombossicon",
            "Action":"SAY",
            "Lines":{
              "en":"The sworn enemies of the Appease-mint family from numerous timelines will bombard your front yard head-on.",
              "zh":"来自各条时间线的平射家族克星们将正面轰击你的前院。"
            }
          },
          {
            "Character":"zombossicon",
            "Action":"SAY",
            "Lines":{
              "en":"Those pathetic little peas are already dead.",
              "zh":"你那几株可怜的豌豆已经死透了。"
            }
          },
          {
            "Character":"zombossicon",
            "Action":"NPC_EXIT"
          },
          {
            "Character":"crazydave",
            "Action":"NPC_ENTER"
          },
          {
            "Character":"crazydave",
            "Action":"EXCITED",
            "Lines":{
              "en":"Impossible!The Appease-mint family is invincible!",
              "zh":"不可能，平射家族天下无敌！"
            }
          },
          {
            "Character":"winnie",
            "Action":"NPC_ENTER"
          },
          {
            "Character":"winnie",
            "Action":"TIRED",
            "Lines":{
              "en":"They're almost here.We'd better think of a plan.",
              "zh":"他们快来了，还是想想对策吧。"
            }
          },
          {
            "Character":"winnie",
            "Action":"SAY",
            "Lines":{
              "en":"Perhaps Dr.Zomboss's army isn't invincible.We can make a strategic retreat and fullyutilize the Split Peas to attack the zombies from behind.",
              "zh":"或许僵尸博士的大军并非无敌。我们可以战略转移，充分利用裂荚射手的优势，从后方打击僵尸。"
            }
          },
          {
            "Character":"crazydave",
            "Action":"EXCITED",
            "Lines":{
              "en":"I have two Escape Roots here.They'll come in handy!",
              "zh":"我这里有两株逃脱树根，正好能派上用场！"
            }
          },
          {
            "Character":"winnie",
            "Action":"TIRED",
            "Lines":{
              "en":"However,relying solely on the Escape Roots is not enough to cover these heavily targeted plants.",
              "zh":"然而，光靠逃脱树根不足以掩护这几株被重点关注的植物。"
            }
          },
          {
            "Character":"winnie",
            "Action":"SAY",
            "Lines":{
              "en":"Perhaps we can turn their strength against them and help with the relocation.",
              "zh":"也许我们可以借力打力，利用敌人的力量帮助转移。"
            }
          }
        ]
      }
    },
