    {
      "aliases":[
        "Backwards_Replay"
      ],
      "objclass":"NarrativeProperties",
      "objdata":{
        "Flow":[
          {
            "Character":"winnie",
            "Action":"NPC_ENTER"
          },
          {
            "Character":"winnie",
            "Action":"SAY",
            "Lines":{
              "en":"Perhaps Dr.Zomboss's army isn't invincible.We can make a strategic retreat and fullyutilize the Split Peas to attack the zombies from behind.",
              "zh":"或许僵尸博士的大军并非无敌。我们可以战略转移，充分利用裂荚射手的优势，从后方打击僵尸。"
            }
          },
          {
            "Character":"winnie",
            "Action":"SAY",
            "Lines":{
              "en":"Perhaps we can turn their strength against them and help with the relocation.",
              "zh":"也许我们可以借力打力，利用敌人的力量帮助转移。"
            }
          }
        ]
      }
    },
    {
			"aliases": [
