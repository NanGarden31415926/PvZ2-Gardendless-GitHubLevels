        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "DEMO_DRAGONBRUIT"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SPECIAL4",
                        "Lines": {
                            "en": "Wow!What kind of plants are these!",
                            "zh": "哇！这些是什么植物呀！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Look at these things,they're strange yet amusing.",
                            "zh": "快看这些家伙，长得奇奇怪怪的，还挺有意思。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Dragonfruits with multiple heads…could these be the legendary Hydra-gan Fruit?",
                            "zh": "拥有多个头的火龙果……莫非这就是传说中的九头蛇龙果？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "While they bear some similar points,they are not the Hydra of ancient myth.",
                            "zh": "二者确有相似之处，但他们并非神话传说中的九头蛇。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "These peculiar plants are called Dragon Bruit.",
                            "zh": "这些古怪的植物名叫暴君火龙果。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "They are shadow plants. When powered in shadow form,they launch poison projectiles at zombies across three adjacent lanes.",
                            "zh": "他们是暗影植物。进入暗影形态后，会向三行的僵尸投掷毒液弹。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "When destroyed, dragon bruit splits into three dragon baby bruits that retain their basic lane attacking ability in their own lane.",
                            "zh": "本体被摧毁后，暴君火龙果会分裂成三株小暴君火龙果。这些小家伙会驻守在随机位置，保留有基础的单行攻击能力。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "I think we can make use of their spreading characteristics to quickly set up our defenses.",
                            "zh": "我想我们这里可以利用他们分裂增殖的特性，快速铺开防线。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "That's crazy cool!Go get'em!Hydras!",
                            "zh": "这简直酷到离谱！上吧，我的九头蛇！"
                        }
                    }
                ]
      }
    },
