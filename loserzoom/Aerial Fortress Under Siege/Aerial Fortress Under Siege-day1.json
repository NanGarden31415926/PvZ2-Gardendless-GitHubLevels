          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "crazydave",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "Penny, what did you just say?",
              "zh": "潘妮，你刚刚说什么"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "She said: 'Dear Dr. Edgar has prepared delicious tacos for Crazy Dave and his neighbor.'",
              "zh": "她说：“亲爱的埃德加博士为疯狂戴夫和他的邻居准备了美味的玉米卷”"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT",
            "Lines": {
              "en": "She said: 'Dear Dr. Edgar has prepared delicious tacos for Crazy Dave and his neighbor.'",
              "zh": "她说：“亲爱的埃德加博士为疯狂戴夫和他的邻居准备了美味的玉米卷”"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "No, I didn't say that.",
              "zh": "不，我没那么说"
