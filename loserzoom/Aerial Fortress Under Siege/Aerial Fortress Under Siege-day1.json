    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en": "Neighbor, you won't believe how delicious that taco was.",
              "zh": "邻居，你简直无法相信那个玉米卷有多好吃"
            }
          },
          {
            "Character": "crazydave",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "I think it was called something like Authentic Mexican-Chinese-Style Pig Brain Taco.",
              "zh": "好像叫什么正宗墨西哥中国风猪脑玉米卷"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "Mind-blowingly delicious!",
              "zh": "震撼美味"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "Tests show that the brain tissue inside did not belong to a pig...",
              "zh": "经检测那里面的脑组织并不属于猪……"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "Let's carry Dave away.",
              "zh": "我们把戴夫架走吧"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_EXIT",
            "Lines": {
              "zh": ""
