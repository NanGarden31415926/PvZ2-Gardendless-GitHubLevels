          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "It seems the deliciousness of human brains is something all zombies... oh no...",
              "zh": "看，人脑的美味是全僵尸……哦不……"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "A consensus among all humanity... Anyway, goodbye, human Dave.",
              "zh": "全人类的共识……总之，再见了人类戴夫"
            }
          },
