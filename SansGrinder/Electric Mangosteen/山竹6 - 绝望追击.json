        {
            "aliases": [
                "PERSUITABLE_INTRO"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "oh hey it's Wednesday isn't it?",
                            "zh": "哦嘿是不是周三了？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "I... don't think - ",
                            "zh": "我……不认为 - "
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "oh i gotta go play persuit else i lose free gems =(",
                            "zh": "哦我得去打追击了，追五不打留级就少拿钻石了 =("
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "welp i gotta go. taking my beloved lvl5 mangosteen with me, ofc",
                            "zh": "我得走喽。当然，带着我的5阶山竹一起走"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Wait! Don't leave! I've detec-",
                            "zh": "等会，先别走！我检测到——"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": ". . . . . .",
                            "zh": ". . . . . ."
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Did he just leave? For real?",
                            "zh": "他走了？真的假的？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "I've detected a lot of intangible timeline turbulence and... ",
                            "zh": "我检测到了大量无法修复的时间线错乱……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "I'm afrid that he will be playing Pirate Seas Day 17, while we have to face his persuit level",
                            "zh": "恐怕他现在会在打海盗港湾第17天，而我们要面对他的追击关"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Persuit level? I thought you are the one who organize persuits?",
                            "zh": "追击？我记得不是你组织的追击吗？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "That's another me, from another timeline, another parallel universe, User Dave.",
                            "zh": "那是另一个平行宇宙的另一条时间线里的我，用户戴夫"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "For now, we should worry about those Level 6 monsters marching onto our ship",
                            "zh": "我们现在更应该担心如何应对这些6阶的怪物"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "WHAT? LEVEL 6?!?!",
                            "zh": "等会？多少阶？！？！"
                        }
                    }
                ]
            }
        },
