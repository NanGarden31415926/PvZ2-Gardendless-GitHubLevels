                ],
                "Name": "聚能山竹史诗任务 - 第一关",
                "NameMultiLanguage": {
                    "en": "Epic Quest - Electric Mangosteen - Level 1",
                    "zh": "聚能山竹史诗任务 - 第一关"
                },
                "LevelNumber": 1,
                "WrittenBy": "SansGrinder",
                "NormalPresentTable": "egypt_normal_01",
                "ShinyPresentTable": "egypt_shiny_01",
                "FirstIntroNarrative": "2c_RELATED_INTRO",
