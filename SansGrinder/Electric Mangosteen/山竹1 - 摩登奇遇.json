            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "2c_RELATED_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Dear insane beard guy, stupid red car and your genius neighbour",
                            "zh": "你们好啊疯胡子，破红车和你们那天才一般的邻居"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I am hereby introducing - level 4 zombies from PvZ2c",
                            "zh": "容我向你介绍——中文版4阶僵尸"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Have fun with those monsters...... NOT!",
                            "zh": "希望你和它们玩的开心……才怪！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "We're screwed! These zombies just wouldn't die!",
                            "zh": "这些僵尸特别难对付！我们完蛋了！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "As Dr. Zomboss breaches our timeline and get his overpowered 2c zombies,",
                            "zh": "在僵王撕裂时间线并招募中文版僵尸时"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I managed to bring back some Electric Mangosteens from PvZ2c",
                            "zh": "我成功的从中文版带回来了一些聚能山竹"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Sadly, their ability to grow and stun zombies was lost in the transfer",
                            "zh": "可惜由于时间线穿梭，他们失去了成长和麻痹僵尸的能力"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Mangosteens? I love both mango and steen!",
                            "zh": "山竹？我既喜欢爬山也喜欢竹笋！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "......",
                            "zh": "……"
                        }
                    }
                ]
            }
        },
