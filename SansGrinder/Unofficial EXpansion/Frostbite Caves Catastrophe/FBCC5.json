			"objdata":{
				"Flow":[
					{
						"Character":"crazydave",
						"Action":"NPC_ENTER"
					},
					{
						"Character":"crazydave",
						"Action":"EXCITED",
						"Lines":{
							"en":"Hey! Neighbour! Guess what have I found?",
							"zh":"嘿！邻居！猜猜我找到了什么？"
						}
					},
					{
						"Character":"crazydave",
						"Action":"TIRED",
						"Lines":{
							"en":"...too cold to guess? Fair...... I guess......",
							"zh":"……太冷了不想猜吗？哎，是够冷的……"
						}
					},
					{
						"Character":"crazydave",
						"Action":"PLAYFUL",
						"Lines":{
							"en":"...anyways, I FOUND SOME OF OUR LAST EXPLOSIVE PLANTS!",
							"zh":"...总之，我找到了我们最后幸存的灰烬植物！"
						}
					},
					{
						"Character":"crazydave",
						"Action":"TIRED",
						"Lines":{
							"en":"......that's... not that exiciting... is it?",
							"zh":"……你...看起来没那么兴奋......"
						}
					},
					{
						"Character":"crazydave",
						"Action":"EXCITED",
						"Lines":{
							"en":"Don't worry, neighbour! Half of our plants still functions normally! Half of them are still......",
							"zh":"别担心，邻居！还有一半的植物能正常用！还有一半……"
						}
					},
          {
						"Character":"crazydave",
						"Action":"TIRED",
						"Lines":{
							"en":"......",
							"zh":"……"
						}
					},
					{
						"Character":"crazydave",
						"Action":"SHOUT",
						"Lines":{
							"en":"NOW LET'S BLOW UP THOSE FILTHY ZOMBIES!!!!!",
							"zh":"快去把这些肮脏的僵尸炸飞！！！！！"
						}
					}
				]
			}
