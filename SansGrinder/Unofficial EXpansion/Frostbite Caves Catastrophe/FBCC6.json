		{
			"aliases":[
				"AROSE_INTRO"
			],
			"objclass":"NarrativeProperties",
			"objdata":{
				"Flow":[
					{
						"Character":"winnie",
						"Action":"NPC_ENTER"
					},
					{
						"Character":"crazydave",
						"Action":"NPC_ENTER"
					},
					{
						"Character":"winnie",
						"Action":"TIRED",
						"Lines":{
							"en":"*electricity buzzing*",
							"zh":"*电流声*"
						}
					},
					{
						"Character":"crazydave",
						"Action":"SAY",
						"Lines":{
							"en":"Penny?",
							"zh":"潘妮？"
						}
					},
					{
						"Character":"winnie",
						"Action":"TIRED",
						"Lines":{
							"en":"NullPointerException at thread main: Cannot cast type null to class Speaker",
							"zh":"NullPointerException at thread main: Cannot cast type null to class Speaker"
						}
					},
					{
						"Character":"winnie",
						"Action":"PLAYFUL",
						"Lines":{
							"en":"......just kidding. My inner system is not coded in Jvav",
							"zh":"……才怪。我内部系统不是用Jvav编写的"
						}
					},
					{
						"Character":"crazydave",
						"Action":"SHOUT",
						"Lines":{
							"en":"PENNY! YOU'RE FINALLY AWAKE!",
							"zh":"潘妮！你可算醒了！"
						}
					},
					{
						"Character":"winnie",
						"Action":"TIRED",
						"Lines":{
							"en":"Scanning surroundings... Warning! Detected some arose ancient beings!",
							"zh":"正在扫描周围环境……警告！检测到一些被唤醒的远古生物！"
						}
					},
					{
						"Character":"winnie",
						"Action":"TIRED",
						"Lines":{
							"en":"They shouldn't have woken up...... unless someone caused a series of serious explosions in attempt to increase the temperature......",
							"zh":"按理说他们不应该醒来……除非有人试图使用大量大规模爆炸物提升温度……"
						}
					},
					{
						"Character":"crazydave",
						"Action":"PLAYFUL",
						"Lines":{
							"en":"Uhh...... let's talk about tacos! Whats your favorite taco?",
							"zh":"呃……还是聊聊玉米卷吧！你最喜欢哪种口味的玉米卷？"
						}
					}
				]
			}
		},
