                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "WARN!NG! My b@tteries are near FROZ3N!",
                            "zh": "警告！我的电氵也忄夬被冻上了！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "Sounds like you should visit our local pepper pult for some warmth",
                            "zh": "看来你需要拜访我们的甜椒投手取取暖了，哈哈"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Where's our pepper pult? Fire peashooter? Torchwood? Lava guava? Where... are you all?",
                            "zh": "诶我们的甜椒投手呢？火豌呢？火炬树桩？岩浆番石榴？你们都去哪了……？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Th0se pl@nts of ours cou1d not b@re the co1d... they either d1ed out or no 1onger functions...",
                            "zh": "我亻门的这些植物要么承受不了冰雪灭纟色了，要么无氵去参加战斗或提亻共温暖"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "NOOOOO! Who's gonna unfreeze my tacoes then!?",
                            "zh": "不！！！！！这样的话谁来解冻我的玉米卷啊！？"
                        }
                    }
                ]
            }
