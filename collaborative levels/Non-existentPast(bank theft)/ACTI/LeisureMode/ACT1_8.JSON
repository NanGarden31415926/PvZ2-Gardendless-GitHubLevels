        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Chaos_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The arrow loosed cannot be recalled.",
                            "zh": "开弓没有回头箭。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "As expected, this time period has become unstable.",
                            "zh": "同设想的一样，这个时间段变得不稳定了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This accelerated the zombies' offensive.",
                            "zh": "这提前了僵尸的攻势。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "What's worse.",
                            "zh": "更糟糕的是。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "After destroying the sunflowers, we cannot obtain sufficient sun.",
                            "zh": "销毁向日葵之后，我们无法得到足够的阳光。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "I'll search for additional plants to support you.",
                            "zh": "我会为你搜寻额外的植物作为支援。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "With the crazy man's assistance, we have more plants available this time.",
                            "zh": "有疯子的协助，这次我们有更多的植物可用。"
                        }
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Chaos_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "An unexpected bonus.",
                            "zh": "意外收获。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "What is this? A plant I've never seen before.",
                            "zh": "这是什么？从来没有见过的植物。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Hold on.",
                            "zh": "等一下。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "There are several types of plant seeds here.",
                            "zh": "这里有好几种植物的种子。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This is most likely a byproduct of the time period collapse.",
                            "zh": "这极有可能是时间段崩溃的副产物。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "I still have to spend a lot of time sorting them out.",
                            "zh": "我还得花大量的时间把他们分拣出来。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Please leave this work to me.",
                            "zh": "这种工作还是交给我吧。"
                        }
                    }
                ]
            }
        },
