        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "AAD_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I need some suns that doesn't come from the sun as a sample.",
                            "zh": "我需要一些不来自太阳的阳光作为样本。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "But there isn't a single sunflower here.",
                            "zh": "可是这里没有哪怕一株向日葵。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "If we could grow sunflowers.",
                            "zh": "如果我们能生产向日葵。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Never mind. That's exactly why I need the suns.",
                            "zh": "算了，这正是我需要阳光的原因。"
                        }
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "AAD_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Nice work, neighbor!",
                            "zh": "干的漂亮！邻居。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "With these suns, I can pinpoint the nearest sunflower.",
                            "zh": "有了这些阳光我就可以定位到最近的向日葵了。"
                        }
                    }
                ]
            }
