        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Smooth_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Protect these sunflowers.",
                            "zh": "保护好这些向日葵。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I need at least one plant to serve as a stable anchor.",
                            "zh": "我需要至少一株作为稳定锚。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Otherwise we will lose the reality that the seeds existing in this time period!",
                            "zh": "否则我们会丢失种子存在于这个时间段的现实！"
                        }
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Smooth_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "What?",
                            "zh": "什么？"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "You lost all your sunflowers!?",
                            "zh": "你损失了所有的向日葵！？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Things don't always go smoothly.",
                            "zh": "事情不总是一帆风顺。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Our efforts came to nothing.",
                            "zh": "我们的努力功亏一篑了。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "That's not the worst part.",
                            "zh": "这不是最糟糕的部分。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We must leave before reality collapses here.",
                            "zh": "我们要赶在这里的现实崩溃前离开。"
                        }
                    }
                ]
            }
        },
