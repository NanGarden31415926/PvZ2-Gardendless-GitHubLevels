    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "哦，我的邻居，你终于醒了。",
              "en": "Oh.My neighbor, you're finally awake."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "你终于可以停止说你那些什么时空、穿越之类的事了。",
              "en": "You can stop with the space-time continuum and time travel stuff."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "僵尸们还在源源不断地进攻你的房子，快去打败他们吧。",
              "en": "The zombies are still attacking your house,so hurry up and defeat them."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstIntroNarrative"
      ]
    },
    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "什么？你说太简单了？",
              "en": "What? You say it's too simple?"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "可是你之前还说你害怕恐怖的铁桶僵尸的。",
              "en": "But you said you were afraid of the scary buckethead zombies."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "哦，那是你昏睡之前的事了。",
              "en": "Oh,that was before you fell asleep."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstOutroNarrative"
      ]
