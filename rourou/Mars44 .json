    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "哦，我的邻居，你终于醒了。",
              "en": "Oh.My neighbor, you're finally awake."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "你终于可以停止说你那些什么时空、穿越之类的事了。",
              "en": "You can stop with the space-time continuum and time travel stuff."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "僵尸们还在源源不断地进攻你的房子，快去打败他们吧。",
              "en": "The zombies are still attacking your house,so hurry up and defeat them."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstIntroNarrative"
      ]
    },
    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "什么？你说太简单了？",
              "en": "What? You say it's too simple?"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "可是你之前还说你害怕恐怖的铁桶僵尸的。",
              "en": "But you said you were afraid of the scary buckethead zombies."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "哦，那是你昏睡之前的事了。",
              "en": "Oh,that was before you fell asleep."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstOutroNarrative"
      ]
    },
    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "我有一个坏消息要告诉你。",
              "en": "I have some bad news for you."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "zh": "今天的的草坪上会出现几个“大家伙”！",
              "en": "Several \"giants\" will appear on your lawn today!"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "zh": "不要再想你梦里的事了，多为现实做考虑吧。",
              "en": "Stop thinking about your dreams and think more about reality."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstIntroNarrative1"
      ]
    },
    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "zh": "太棒了！这些僵尸被我们打退了！",
              "en": "Yay! We fended off the zombies!"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "天色快暗了，今天僵尸们应该不会再来了。",
              "en": "It's getting dark and the zombies probably won't come back today."
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstOutroNarrative1"
      ]
    },
