    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en":"Hey, I remember I was drinking lemonade in the backyard...",
              "zh": "嘿，我记得我还在后院喝柠檬水来着……"
            }
          },
          {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en":"What is this place? And... where has Penny gone?",
              "zh": "这又是什么地方？还有......潘妮去哪里了？"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en":"Dave, how do you like the exile place I chose for you?",
              "zh": "戴夫，我为你挑选的流放之地怎么样啊？"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en":"Without your old car, you're nothing now. You'll spend the rest of your life here!",
              "zh": "没了你的那辆破车，你现在什么都不是。你就在这里度过你的余生吧！"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en":"Oh... I don't want to spend the rest of my life with dinosaurs and primitive humans...",
              "zh": "噢......我可不想与恐龙和原始人一起度过我的后半生......"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en":"No, no... I should say primitive zombies ...",
              "zh": "不不......应该说是原始僵尸......"
            }
          }
        ]
      },
