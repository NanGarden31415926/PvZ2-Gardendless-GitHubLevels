        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Storm_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Sunflower has been deployed.",
                            "zh": "向日葵已部署。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Although there were only two.",
                            "zh": "虽然只有两株。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "That's far too little.",
                            "zh": "这也太少了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The good news is, I've detected the presence of sunflower seeds within the time stream.",
                            "zh": "不过好消息是，我捕获到了向日葵种子在时间流域里的存在。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Is this meager life finally coming to an end?",
                            "zh": "这拮据的生活终于要到头了吗！"
                        }
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "Storm_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Time jump preparation complete.",
                            "zh": "时间跳跃准备完毕。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Once I've packed my bags.",
                            "zh": "等我收拾好行李。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "That's not necessary. This time, there's enough energy to cover the entire area.",
                            "zh": "不必，这次有充足的能量覆盖到这里的全部。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Toward the taco—no, toward the sunflower!",
                            "zh": "向玉米卷，不对，向日葵前进！"
                        }
                    }
                ]
            }
        },
