        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "TimeJugglery_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Time period: Not registered.",
                            "zh": "时间段：未注册。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "My instrument indicates that the zombie here has fallen into a time loop.",
                            "zh": "仪器显示这里的僵尸掉进了闭环的时间。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Additionally.",
                            "zh": "另外。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "We've lost all the seeds!",
                            "zh": "我们遗失了全部的种子！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "My plant collection has also disappeared.",
                            "zh": "我收集的植物也不见了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "They are not within the range of emergency time jump.",
                            "zh": "他们不在紧急进行的时间跳跃范围内。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "We're sunk! The plants in the yard look pathetic!",
                            "zh": "我们完了，院子里的植物看起来逊毙了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Received plant communication signal.",
                            "zh": "接到植物通讯信号。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "They asked, “Did you forget your manners?”",
                            "zh": "他们说“你礼貌吗？”"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Received plant communication signal.",
                            "zh": "接到植物通讯信号。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The delivery Root found three plants during this time period.",
                            "zh": "快递员在这个时间段找到三株植物。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "According to her, they were fending off another invasion.",
                            "zh": "据她所说，他们在抵御另一场入侵。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We can select one to support the defenses here.",
                            "zh": "我们可以选择一株来支援这边的防线。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Wait, I found a small packet of marigold in my pants pocket.",
                            "zh": "等等，我在裤兜翻到一小包金盏花。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Nice work, user Dave!",
                            "zh": "干的漂亮，用户戴夫！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "At least, we can provide delivery Root with additional stepping stones.",
                            "zh": "我们至少能给快递员提供额外的跳板了。"
                        }
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "TimeJugglery_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "Look, a packet of seeds!",
                            "zh": "看，是一包种子！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Warning!",
                            "zh": "警告！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Time continuity errors have increased!",
                            "zh": "时间连续性错误增加了！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "The past is collapsing!",
                            "zh": "过去在崩溃！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "We don't have much time left.",
                            "zh": "我们的时间不多了。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Everything that has just happened will also disappear.",
                            "zh": "刚刚经历的一切也会变得不复存在。"
                        }
                    }
                ]
            }
        },
