                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This is an opportunity, neighbor.",
                            "zh": "这是一次机遇，邻居。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "……",
                            "zh": "……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This could lead to some irreversible consequences.",
                            "zh": "这可能会导致一些不可挽回的后果。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I hope we truly understand what we're doing.",
                            "zh": "希望我们切实知道我们在做什么。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "……",
                            "zh": "……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This must not be known to the crazy man.",
                            "zh": "这不能让疯子知道。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "……",
                            "zh": "……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Let's get moving,time is running out.",
                            "zh": "开始行动吧，我们的时间不多。"
                        }
