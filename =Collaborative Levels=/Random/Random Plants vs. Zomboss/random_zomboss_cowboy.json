            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Howdy, my greatest enemy",
                            "zh": "你好啊，我的仇敌"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "What's that look on your face? Did you not like my Zombot War Wagon 2.0?",
                            "zh": "怎么，你这是什么表情？你不喜欢我的重型战马车2.0吗？"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Worry not, I shall bring back all those primal fears you had!",
                            "zh": "别担心，我会帮你找回所有遗忘的恐惧！"
                        }
                    }
                ]
            }
        },
        {
            "aliases": [
                "RANDOM_OUTRO_WEST"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "You've defeated me fair and square in a 1 on 1 duel...... NOT! ",
                            "zh": "你公平公正地赢下了这次单挑……才怪！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Don't think I didn't catch that! You were cheating! ",
                            "zh": "别以为我没发现！你在作弊！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "But it won't matter! No matter how hard you try, I will shatter your faith ruthlessly!",
                            "zh": "但不重要！无论你多努力，我会无情的碾碎你的自尊心！"
                        }
                    }
                ]
            }
        },
