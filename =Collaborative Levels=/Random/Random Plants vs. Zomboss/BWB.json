        {
            "aliases": [
                "RANDOM_INTRO_BEACH"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Haha! It's back! My beloved Zombot Sharktronic Sub 2.0!",
                            "zh": "哈哈哈！它回来了！我最爱的巨鲨号深潜艇2.0！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "You didn't think you could restrict its powers forever, did you?",
                            "zh": "你不会认为你能永远封印它的能力吧？"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Wahahaha! Prepare for destruction!",
                            "zh": "哇哈哈哈！做好毁灭的准备吧！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Something fishy is going on",
                            "zh": "有什么不太对劲"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Warning! Dr. Zomboss has restored his Zombot's full power!",
                            "zh": "警告！僵尸博士把他的机甲恢复到了巅峰时期的状态！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "WHAT DOES THAT EVEN MEAN???????",
                            "zh": "不是这又是什么意思啊喂？？？？？？？"
                        }
                    }
                ]
            }
        },
        {
            "aliases": [
                "RANDOM_OUTRO_BEACH"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "No! No! NO! My beloved Zombot Sharktronic Sub 2.0!",
                            "zh": "不！不！不！！！我最爱的巨鲨号深潜艇2.0！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I will make you pay for this!",
                            "zh": "我会让你付出代价的！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "So, what did you mean by \"restored his Zombot's full power\", Penny?",
                            "zh": "所以，潘妮，你说的“把他的机甲恢复到了巅峰时期的状态”是什么意思呢？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Well, that's a long story......",
                            "zh": "额，说来话长……"
                        }
                    }
                ]
            }
        },
