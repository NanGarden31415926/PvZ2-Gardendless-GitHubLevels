        {
            "aliases": [
                "RANDOM_INTRO_FUTURE"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Yes, of course, Dave! I can see into the future! I am the future!",
                            "zh": "当然了，戴夫！我可以预见未来！我就是未来！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Penny, what are the chances Dr. Zomboss can see into the future, and all of our effort is futile?",
                            "zh": "潘妮，你说有没有一种可能，僵尸博士能预见未来，而我们的努力确实是徒劳的？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "I'm afraid the question has already been answered, User Dave......",
                            "zh": "恐怕这个问题已经被回答过了，用户戴夫……"
                        }
                    }
                ]
            }
        },
        {
            "aliases": [
                "RANDOM_OUTRO_FUTURE"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "What, you think I've failed? You'd be so wrong!",
                            "zh": "怎么，你认为我失败了吗？大错特错！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It was my plan all along, and your irresistible future is approaching! ",
                            "zh": "这一切都在我的计划之内，而你那无法抗拒的未来即将到来！"
                        }
                    }
                ]
            }
        },
