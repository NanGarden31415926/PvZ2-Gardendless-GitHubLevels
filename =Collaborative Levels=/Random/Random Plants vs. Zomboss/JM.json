        {
            "aliases": [
                "RANDOM_INTRO_DINO"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Hey, me have dino, me happy, you die!",
                            "zh": "嘿，我有恐龙，我开心，你死！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Go dino! Graaaaaaaaaargh",
                            "zh": "去吧，恐龙！啊啊啊啊啊啊啊哈哈哈"
                        }
                    }
                ]
            }
        },
        {
            "aliases": [
                "RANDOM_OUTRO_DINO"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Is it just me or is Zomboss losing his mind?",
                            "zh": "就我觉得僵王有点精神失常了吗？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Not if you consider the fact that he's transporting an insane amount of potential airplane fuel right now......",
                            "zh": "精神失常的人可不会运输海量的石油……"
                        }
                    },

                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We should also fuel up our airship while we're still here",
                            "zh": "趁我们还在侏罗纪沼泽，我们也应该给我们的飞船加点油了"
                        }
                    }
                ]
            }
        },
