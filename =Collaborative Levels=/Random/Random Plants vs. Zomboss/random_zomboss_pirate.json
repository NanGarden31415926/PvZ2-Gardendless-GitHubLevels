                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Ya fools darez following me into my very own trap?",
                            "zh": "汝等胆敢跟随我进入我自己的陷阱？"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Foolish! Shall you be trapped in the storm with me!",
                            "zh": "愚蠢！你我早已被困在雷暴中央！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The storm shows no mercy! Embrace your doom!",
                            "zh": "雷暴可没有仁慈之心！接受你的毁灭吧！"
                        }
                    }
                ]
            }
        },
