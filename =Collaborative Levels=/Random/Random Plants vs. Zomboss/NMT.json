                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Aarrgh! Whatever! You're not going to survive what comes next!",
                            "zh": "无所谓了，你是不可能从我手里活下来的！"
                        }
