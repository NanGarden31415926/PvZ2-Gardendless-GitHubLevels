                        "Action": "SAY",
                        "Lines": {
                            "en": "Warning! I've noted some disturbingly discord notes!",
                            "zh": "警告！我注意到了一些极其不和谐的音符！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "...... what is that supposed to mean?",
                            "zh": "……那是什么意思？"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Dr. Zomboss might have improved his speakers!",
                            "zh": "僵尸博士可能升级了他的音响！"
                        }
                    }
                ]
            }
