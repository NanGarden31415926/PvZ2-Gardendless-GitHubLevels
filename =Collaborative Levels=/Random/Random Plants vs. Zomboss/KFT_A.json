            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Two of my friends wants a \"friendly rematch\" with you, and sadly \"no\" is not an option!",
                            "zh": "我有两位朋友想跟你来场重赛，强制性的那种"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "While they annihilate you, I will ensure your destruction in the near future!",
                            "zh": "在他们暴揍你的同时，我会确保你死的惨不忍睹！"
                        }
                    }
                ]
            }
        },
        {
