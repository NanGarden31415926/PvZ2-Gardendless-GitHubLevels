                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "What, did you think that was it?",
                            "zh": "怎么，你不会以为这就结束了吧？"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Qigong Master is on his on his way to your lawn! You shall face destruction any moment now!",
                            "zh": "气功教主正在赶来！你很快就可以被揍得粉身碎骨了！"
                        }
                    }
                ]
