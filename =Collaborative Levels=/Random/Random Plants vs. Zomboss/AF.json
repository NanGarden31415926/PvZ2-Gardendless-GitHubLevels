                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "It's a beautiful day outside......",
                            "zh": "真是美好的一天啊……"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "The sun is shining, the lightnings are roaring......",
                            "zh": "太阳在照耀，电闪在雷鸣……"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "On days like these, gardeners like you......",
                            "zh": "在这样的日子里，像你这样的园主……"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "STOP MAKING THOSE STUPID REFERENCES!!!!!!!!!!!!!!",
                            "zh": "能不能别玩这种陈年烂梗了啊啊啊啊啊啊啊啊啊啊"
                        }
                    }
                ]
