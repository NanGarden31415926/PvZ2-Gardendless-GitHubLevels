        {
            "aliases": [
                "INTRO"
            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Witch Hazel is a true master of magic.",
                            "zh": "女巫金缕梅是真正的魔法大师。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "With just a flick of her wand, she turns zombies into harmless Puff-shrooms.",
                            "zh": "她稍一施法，就能将僵尸变成人畜无害的小喷菇。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "That defies all logic, but that's simply how her magic works—transforming decay into new life.",
                            "zh": "那似乎完全不合逻辑，但她的魔法就是如此运作——把腐朽转化为新生。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Plus, her spells prioritize WIZARD ZOMBIES. Taking down magic with magic is just her thing!",
                            "zh": "此外，她的法术会优先锁定巫师僵尸。以魔法对抗魔法，正是她的拿手好戏。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Magic vs. magic? That's awesome! I'm so into it!",
                            "zh": "用魔法对付魔法？太妙了！我喜欢这个主意！"
                        }
                    }
                ]
            }
        },
