    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "我们的种子库存系统正在受到攻击。",
              "en": "Our seedbank system is under attack."
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "今天我们只能派遣五株植物上场。",
              "en": "We can only send 5 plants to the frontlawn today."
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "另外，僵尸们偷走了一部分植物种子，这导致我们以后每一天都有一些植物不能使用。",
              "en": "In additonal,zombies have stolen some of the seeds,which means that we won't be able to use some plants every day from now on."
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "看起来我该升级花园防火墙了。",
              "en": "It seems that I should upgrade the garden firewall."
            }
          },
          {
            "Character": "crazydave",
            "Action": "PLAYFUL",
            "Lines": {
              "zh": "邻居！现在先用这些便宜的暗影龙葵撑场面吧！记得妥善利用他们！",
              "en": "Hey neighbor!Use these inexpensive nightshades to create a occasion!Remember to make good use to them!"
            }
          }
        ]
      },
      "aliases": [
        "EditorFirstIntroNarrative"
      ]
