    {
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "欢迎回来！玉米卷疯子和破烂铁皮！",
              "en": "Welcome back! Crazy tacoman and broken tin!"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "zh": "怎么回事？我们不是才刚刚击溃你和你的僵尸军团吗？",
              "en": "What's going on?Didn't we just defeat you and your zombie army?"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "哦戴维，你未免太愚蠢了一点...",
              "en": "Oh David,You are a little stupid..."
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "我的悖论计划能够帮助我在危急时刻逆转时空，再次回到最初！",
              "en": "The project paradox can take me back to the start again when I was in danger!"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "zh": "现在迎接更加猛烈的僵尸军团吧！木哈哈哈哈！",
              "en": "Now face the more huge wave of zombies! Muhahahaha!"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT",
            "Lines": {
              "zh": ""
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "zh": "这消息听起来太糟了...",
              "en": "That new sounds too bad..."
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "现在不是惋惜的时候，用户戴夫。",
              "en": "Now is not the time for regret,User Dave."
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "zh": "僵王博士现在会用更为丰富的僵尸组合来进攻庭院，我们需要提高警惕。",
              "en": "Zomboss will use more diverse lineup of zombies to attack our frontyard.We need to get attentioned."
            }
          }
        ]
      },
