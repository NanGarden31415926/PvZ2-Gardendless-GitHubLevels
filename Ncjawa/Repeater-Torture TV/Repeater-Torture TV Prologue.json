    {
      "objclass": "NarrativeProperties",
      "aliases": [
        "R0_INTRO"
      ],
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "Oh,man.....",
              "zh": "（男人叹气声）"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "The Repeater is too weak.....",
              "zh": "这个牢双怎么这么菜啊......"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "I can't agree more,Uesr Dave.",
              "zh": "兑。，英改师。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Then just buff the Repeater already!!",
              "zh": "那就快点加强牢双啊（怒"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "One more question and it's getting deleted.",
              "zh": "再问删了。"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "......",
              "zh": "......"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_EXIT"
          }
        ]
      }
    },
    {
      "objclass": "NarrativeProperties",
      "aliases": [
        "R0_OUTRO"
      ],
      "objdata": {
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "Wow,a bottle of sauce!",
              "zh": "哇哦，一瓶酱！"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Don't touch that sauce!",
              "zh": "别动那瓶酱！"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "It's for the Repeater!",
              "zh": "那是给牢双的！"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "But where's the Repeater?",
              "zh": "但是牢双去哪了？"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": ".......I don't know.",
              "zh": "我不知道。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Then I'm claiming this sauce for myself!",
              "zh": "既然牢双不在，那这瓶酱就归我了！"
            }
          },
          {
            "Character": "crazydave",
            "Action": "BRINGOUT_TACO"
          },
          {
            "Character": "crazydave",
            "Action": "EAT_TACO"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "*Burps.",
              "zh": "吃饱了。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": ".......",
              "zh": "........"
            }
          },
          {
            "Character": "winnie",
            "Action": "NPC_EXIT"
          }
        ]
      }
